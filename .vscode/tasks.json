{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build Enigma",
      "type": "shell",
      "command": "g++",
      "args": [
        "-std=c++17",
        "-Wall", "-Wextra",
        "src/*.cpp",
        "-Iinclude",
        "-o", "build/A1"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$gcc"]
    }
  ]
}
